project_name         = "terraform"
region_name          = "eu-west-3"
availability_zone    = "eu-west-3a"

# Estrategia 1: ID directo de la VPC
vpc_id               = "vpc-c2df3aaa"

# Estrategias 2 y 3: nombre de la VPC (tag Name).
